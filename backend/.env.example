# MySQL 连接（docker-compose 容器映射到宿主机 3307，避开本地 3306）
DATABASE_URL=mysql+aiomysql://mtt:mttpass@127.0.0.1:3307/mytokentransfer

# 登录主密码（本地单用户认证）
MASTER_PASSWORD=change-me-to-a-strong-password

# Session 签名密钥（任意随机串，用于签发登录态）
SECRET_KEY=change-me-to-a-random-secret

# 密钥静态加密用 Fernet key；生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# 登录态有效期（秒），默认 7 天
SESSION_MAX_AGE=604800

# 网关统一访问密钥（客户端用 Bearer <此值> 调用 /v1/* 接口）
GATEWAY_TOKEN=change-me-gateway

# 前端地址（CORS）
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
