# ============================================================
#  MyTokenTransfer —— Docker Compose 环境变量示例
#  使用方式：
#    1) 复制本文件为 .env：   copy .env.example .env
#    2) 修改下方三个 “必填” 项（MASTER_PASSWORD / SECRET_KEY / GATEWAY_TOKEN）
#    3) 执行：docker compose up -d --build
# ============================================================

# —— 数据库（有默认值，可不改；生产请改强密码）——
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=mytokentransfer
MYSQL_USER=mtt
MYSQL_PASSWORD=mttpass

# —— 后端认证 / 签名 / 密钥（必填） ——————————————————————————
# 管理台登录密码
MASTER_PASSWORD=change-me-to-a-strong-password

# Session 签名密钥（32+ 位随机字符串，可用 openssl rand -hex 32 生成）
SECRET_KEY=change-me-to-a-long-random-secret-please-change-0001

# 网关统一访问令牌：客户端调用 /v1/* 时使用 Bearer <此值>
GATEWAY_TOKEN=change-me-gateway-token

# （可选）密钥静态加密 Fernet key；留空则由 SECRET_KEY 自动派生
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# —— 登录态有效期（秒），默认 7 天 ——
SESSION_MAX_AGE=604800

# —— 前端对外端口（宿主端口，默认 8080）——
#   访问地址：http://127.0.0.1:8080
WEB_PORT=8080

# —— Redis（用于 session pin / 限流 / 热点缓存；compose 内置 redis:7-alpine）——
# 首次部署会自动生成 32 字符 hex 强密码；手动改完务必同步更新下面 REDIS_URL
REDIS_PASSWORD=change-me-redis-password
# compose 网络内用 service 名；外部调试可用 host.docker.internal:6379
REDIS_URL=redis://:change-me-redis-password@redis:6379/0
